# Dockerfile это инструкция для сборки только этого Django-приложения в контейнере Docker. В результате выполнения
# Dockerfile, Docker создаёт один готовый закрытый образ (image), в котором находится полностью упакованное приложение.


# 1. Базовый образ Python. Команда FROM берет готовый официальный шаблон Linux (Debian) из Docker Hub, если его нет
# на хосте, в который разработчики уже установили Python версии 3.13. Слово slim означает, что из этой ОС вырезано
# всё лишнее (оставили только текстовую консоль и ядро), чтобы образ весил мало и скачивался быстро.
# Сверху туда уже установлены: интерпретатор Python 3.13, утилита pip для установки библиотек,
# базовые системные папки Linux (вроде /etc, /var, /usr)

FROM python:3.13-slim


# 2. Из скачанного в #1 образа ОС Linux (Debian) устанавливаем системные программы Linux в наш контейнер:
    # apt-get update — обновляет список доступных программ в Linux;
    # build-essential — устанавливает компиляторы (инструменты для сборки кода из исходников);
    # libpq-dev — специальная библиотека (драйвер для базы данных), без которой Python не сможет скомпилировать пакет
    # psycopg2 для подключения к базе данных PostgreSQL
    # rm -rf ... — удаляет временные скачанные файлы, чтобы контейнер не раздувался в размерах /флаги -y (Yes) заранее
    # отвечает «Да, устанавливай без лишних вопросов», для автоматической установки, без участия человека;
    # rm -rf (remove) рекурсивно(r-recursive ) и принудительно(f-force ) удаляем установочную папку /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 3. Создаем рабочую директорию внутри контейнера (создается папка с именем /app, и Docker виртуально «переходит»
# в неё (как команда cd /app). Все следующие команды (копирование, запуск) будут выполняться именно внутри этой папки.)
WORKDIR /app

# 4. Установка Poetry прямо внутрь контейнера. Флаг --no-cache-dir запрещает сохранять временные установочные файлы.
RUN pip install --no-cache-dir poetry

# 5. Отключаем создание виртуальных окружений в Poetry. Эта команда заставляет Poetry ставить все библиотеки глобально
# в систему контейнера, потому что контейнер — это уже изолированная система.
RUN poetry config virtualenvs.create false

# 6. Копирование файлов зависимостей со списком библиотек с локального компьютера в контейнер в папку /app (шаг #3).
COPY pyproject.toml poetry.lock ./

# 7. Скачиваем и устанавливаем все библиотеки, зарегистрированные в pyproject.toml и poetry.lock
RUN poetry install --no-root --no-interaction --no-ansi

# 8. Копируем абсолютно весь оставшийся код проекта в контейнер. Первая точка означает «всё из текущей папки на моем
# компьютере», вторая точка — «скопировать в текущую папку контейнера (/app)»
COPY . .
