.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Виртуальное окружение (Важно!) ---
.venv/
venv/
ENV/
env/
python/

# --- Кэш Python ---
**/__pycache__/
*.py[cod]
*$py.class

# --- База данных Django (Не должна попасть на GitHub!) ---
*.sqlite3

