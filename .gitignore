/media/
/staticfiles/

# --- Файлы окружения с секретными ключами и паролями ---
.env
*.env

# --- Локальные файлы bootstrap
catalog/static/catalog/css/bootstrap.min.css
catalog/static/catalog/js/bootstrap.bundle.min.js
/static
