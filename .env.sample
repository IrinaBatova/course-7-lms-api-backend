# Создайте файл .env из копии этого файла и замените значения переменных реальными данными

# API-ключи
GITHUB_TOKEN=your_github_token_here

# Безопасность Django
SECRET_KEY=your_secret_key_here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Настройки базы данных PostgreSQL
DB_NAME=your_db_name_here
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# Настройки для почты mail
EMAIL_USER=your_email # Адрес почтового ящика
EMAIL_PASSWORD=your_email_password_here # 16-значный ПАРОЛЬ ПРИЛОЖЕНИЯ без пробелов

# Настройки для stripe
STRIPE_SECRET_KEY=sk_test_your_key_string_from_the_Stripe_dashboard
